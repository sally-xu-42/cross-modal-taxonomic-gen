#!/bin/bash
#SBATCH --job-name=eval_vlm
#SBATCH --partition=speech-gpu
#SBATCH --cpus-per-task=2
#SBATCH -G1
#SBATCH --exclude=g11
##SBATCH --constraint=48g
#SBATCH --mail-user=sallyxu@ttic.edu
#SBATCH --open-mode=append
#SBATCH --mail-type=ALL
#SBATCH --time=04:00:00
#SBATCH --signal=SIGHUP@600
#SBATCH -o /share/data/speech/txu/vlm_semantics/logs/eval_%j.out

# Set environment variables
export HF_HOME="/share/data/speech/txu/cache"
export TOKENIZERS_PARALLELISM=false  # Disable tokenizer parallelism for PyTorch DataLoaders
export WANDB__SERVICE_WAIT=300

workdir="/share/data/speech/txu/vlm_semantics"
cd $workdir
source $workdir/venv/bin/activate

case $TASK in

    ppl)
        prefix="python3"
        application="src/eval_things.py"
        options="--model_path ${MODEL_PATH} \
                --dataset_path ${DATASET_PATH} \
                --image_dir ${IMAGE_DIR} \
                --output_path ${OUTPUT_PATH}"
        ;;

    ppl_checkpoints)
        for checkpoint in ${MODEL_PATH}/checkpoints/*; do
            CMD="$workdir/scripts/eval.sh -t ppl -m $checkpoint"
            echo $CMD
            eval $CMD
            sleep 200
        done
        echo -e "\nStarted evaluation for each checkpoint of ${MODEL_PATH}"
        exit 0
        ;;
    *)
        echo -n "unknown task name"
        ;;
esac

echo -e "JobID: $SLURM_JOB_ID\n======"
echo "Time: `date`"
echo "Running on master node: `hostname`"

CMD="$prefix $workdir/$application $options"
echo -e "\nExecuting command:\n==================\n$CMD\n"
eval $CMD
