#!/bin/bash
#SBATCH --partition=greg-gpu,speech-gpu
#SBATCH --cpus-per-task=10
##SBATCH --nodelist=g0
#SBATCH --exclude=g6,g14,g15,g19
#SBATCH --constraint=48g
#SBATCH --gpus=4
#SBATCH --mail-user=sallyxu@ttic.edu
#SBATCH --open-mode=append
#SBATCH --mail-type=ALL
##SBATCH --time=23:55:00
#SBATCH --signal=SIGHUP@600
#SBATCH --dependency=singleton
#SBATCH -o /share/data/speech/txu/vlm_semantics/logs/training_%j.out

# Set environment variables
export HF_HOME="/share/data/speech/txu/cache"  # Optional: Set Hugging Face cache directory
export TOKENIZERS_PARALLELISM=false  # Disable tokenizer parallelism for PyTorch DataLoaders
export WANDB__SERVICE_WAIT=300
# export NCCL_DEBUG=INFO
# export TORCH_DISTRIBUTED_DEBUG=INFO
# export CUDA_VISIBLE_DEVICES=0,1,2,3
# export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:128
# export CUDA_LAUNCH_BLOCKING=1  # For debugging

# Define experiment parameters
# RUN_ID="train-clevr-align-$(date +%s)"  # Unique run ID with timestamp
RUN_ROOT_DIR="/share/data/speech/txu/vlm_semantics/runs"
RUN_ID="${STAGE}-${MODEL_ID}-${DATASET_ID}-${SEED}"
RESET_FOR_NEW_STAGE="${RESET_FOR_NEW_STAGE:-False}"

# Activate the virtual environment
cd /share/data/speech/txu/vlm_semantics
source /share/data/speech/txu/vlm_semantics/venv/bin/activate

ARGS=(
    --run_root_dir "$RUN_ROOT_DIR"
    --seed "${SEED}"
    --stage "$STAGE"
    --dataset.type "$DATASET_ID"
    --model.type "$MODEL_ID"
    --model.align_per_device_batch_size 4
    --model.align_global_batch_size 16
    --model.align_epochs 5
    --model.finetune_per_device_batch_size 4 # 128
    --model.finetune_global_batch_size 32 # 512
    --model.finetune_epochs 5 # trying to overfit 
)

if [[ -n "${CHECKPOINT}" ]]; then
    RUN_ID=$(basename "${CHECKPOINT}") 
    CHECKPOINT="${RUN_ROOT_DIR}/${CHECKPOINT}"
    ARGS+=(--resume_from_checkpoint "${CHECKPOINT}/checkpoints/latest-checkpoint.pt")
    ARGS+=(--run_id "$RUN_ID")  # Force same run ID
    # ARGS+=(--reset_for_new_stage) # Used in multistage training (align -> finetune)
    echo "Resuming from checkpoint: ${CHECKPOINT}/checkpoints/latest-checkpoint.pt"
    echo "Using existing run directory: ${RUN_ID}"
    echo "Reset for new stage: ${RESET_FOR_NEW_STAGE}"
else
    ARGS+=(--run_id "${RUN_ID}")
    echo "Starting fresh training (no checkpoint specified)"
fi

# Run training with torchrun
torchrun --standalone --nnodes 1 --nproc-per-node 4 prismatic-vlms/scripts/resumable_pretrain.py "${ARGS[@]}"
